<Window x:Class="Grimlo.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grimlo Settings"
        Width="600" Height="650"
        MinWidth="520" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E24"
        Foreground="#ECECF1"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A32" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#444450" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A32" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#444450" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A32" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="BorderBrush" Value="#444450" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E4C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#555566" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#26262E" BorderBrush="#3A3A46" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,6,0" Padding="14,8">
                            <ContentPresenter ContentSource="Header" TextBlock.Foreground="#AAAAAA" TextBlock.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2E382E" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4CAF50" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Tabs Content -->
            <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="0" Margin="0,0,0,16">
            <!-- TAB 1: AI Provider -->
            <TabItem Header="🧠 AI Brain">
                <StackPanel Margin="4,16,4,0">
                    <TextBlock Text="AI Provider &amp; Model" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="Choose which brain powers Grimlo and securely store your API keys."
                               FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                    <!-- Active Provider -->
                    <TextBlock Text="Active Provider" FontWeight="Medium" Margin="0,0,0,6" />
                    <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderCombo_SelectionChanged" Margin="0,0,0,14">
                        <ComboBoxItem Content="Google Gemini" Tag="gemini" />
                        <ComboBoxItem Content="Anthropic Claude" Tag="claude" />
                        <ComboBoxItem Content="OpenAI" Tag="openai" />
                    </ComboBox>

                    <!-- Model Selection -->
                    <TextBlock Text="Model Name" FontWeight="Medium" Margin="0,0,0,6" />
                    <ComboBox x:Name="ModelCombo" IsEditable="True" Margin="0,0,0,14" />

                    <!-- API Key -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <TextBlock Text="API Key" FontWeight="Medium" />
                        <TextBlock x:Name="KeyStatusLabel" Text=" (No key saved)" Foreground="#FFAA55" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" Margin="0,0,0,6" />
                    <TextBlock Text="Keys are encrypted with Windows DPAPI (CurrentUser) before saving to disk."
                               FontSize="11" Foreground="#7E7E8A" Margin="0,0,0,10" />

                    <!-- Free Gemini API Key Info Banner -->
                    <Border Background="#252F26" BorderBrush="#388E3C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💡 Free Gemini API Key" FontWeight="SemiBold" Foreground="#81C784" Margin="0,0,0,3" />
                            <TextBlock FontSize="12" Foreground="#C8E6C9" TextWrapping="Wrap">
                                <Run Text="You can get a free API key for Google Gemini at " />
                                <Hyperlink NavigateUri="https://aistudio.google.com/api-keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#66BB6A" TextDecorations="Underline">
                                    https://aistudio.google.com/api-keys
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Test Connection & Status Message -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestButton" Content="Test Connection" Click="TestButton_Click" Width="130" />
                        <TextBlock x:Name="TestStatusText" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Medium" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: Personality Master Control -->
            <TabItem Header="🎛️ Master Control">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                    <StackPanel Margin="4,16,4,0">
                        <TextBlock Text="Personality Master Control" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Tune Grimlo's psyche: balance his theatrical bluster, pitiful brooding, and uncanny normalcy."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,16" />

                        <!-- Slider 1: Bluster vs Brooding -->
                        <TextBlock Text="Theatrical Bluster vs. Pitiful Brooding" FontWeight="Medium" Margin="0,0,0,6" />
                        <Slider x:Name="BlusterSlider"
                                Minimum="1" Maximum="5"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight"
                                ValueChanged="PersonalityControl_Changed"
                                Margin="0,0,0,6" />

                        <Border Background="#25252E" BorderBrush="#3E3E4C" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                            <TextBlock x:Name="BlusterDescLabel"
                                       Text="Level 3: Signature Melodramatic Balance..."
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Slider 2: Normalcy vs Gremlin Chaos -->
                        <TextBlock Text="Lucid Normalcy vs. Gremlin Chaos" FontWeight="Medium" Margin="0,0,0,6" />
                        <Slider x:Name="NormalcySlider"
                                Minimum="1" Maximum="5"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight"
                                ValueChanged="PersonalityControl_Changed"
                                Margin="0,0,0,6" />

                        <Border Background="#25252E" BorderBrush="#3E3E4C" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                            <TextBlock x:Name="NormalcyDescLabel"
                                       Text="Level 3: Uncanny Whiplash..."
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Custom Lore / Micro-Interests -->
                        <TextBlock Text="Custom Lore &amp; Micro-Interests (Optional)" FontWeight="Medium" Margin="0,0,0,4" />
                        <TextBlock Text="Canon: Crocheting sweaters, BA in Digital Communications, Swedish fish. Add extra quirks:"
                                   FontSize="11" Foreground="#9E9EA8" Margin="0,0,0,6" />
                        <TextBox x:Name="CustomMicroInterestsBox"
                                 Height="55"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="PersonalityControl_TextChanged"
                                 Margin="0,0,0,14" />

                        <!-- Custom Instructions / Directives -->
                        <TextBlock Text="Custom Directives &amp; Nicknames (Optional)" FontWeight="Medium" Margin="0,0,0,4" />
                        <TextBox x:Name="CustomInstructionsBox"
                                 Height="55"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="PersonalityControl_TextChanged"
                                 Margin="0,0,0,14" />

                        <!-- Live System Prompt Inspector -->
                        <Expander Header="🔍 Live System Prompt Preview" Foreground="#A0A0B0" FontWeight="SemiBold" Margin="0,0,0,8" IsExpanded="False">
                            <Border Background="#16161C" BorderBrush="#333340" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                <TextBox x:Name="LivePromptPreviewBox"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#B0B0C0"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Height="130"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: 🎙️ Voice & Behavior -->
            <TabItem Header="🎙️ Voice &amp; Idle">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <StackPanel Margin="4,16,4,0">
                        <TextBlock Text="Speech &amp; Windows TTS Voice" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Customize Grimlo's spoken voice from the speech synthesizer engines installed on Windows."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                        <!-- Voice Selection -->
                        <TextBlock Text="Windows Voice" FontWeight="Medium" Margin="0,0,0,6" />
                        <ComboBox x:Name="VoiceCombo" Margin="0,0,0,14" />

                        <!-- Speech Rate Slider -->
                        <TextBlock Text="Speech Speed (Rate)" FontWeight="Medium" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VoiceRateSlider"
                                    Grid.Column="0"
                                    Minimum="-10" Maximum="10"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="0"
                                    ValueChanged="VoiceRateSlider_ValueChanged" />
                            <TextBlock x:Name="VoiceRateLabel"
                                       Grid.Column="1"
                                       Text="Normal (0)"
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <!-- Voice Volume Slider -->
                        <TextBlock Text="Voice Volume" FontWeight="Medium" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VoiceVolumeSlider"
                                    Grid.Column="0"
                                    Minimum="0" Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="100"
                                    ValueChanged="VoiceVolumeSlider_ValueChanged" />
                            <TextBlock x:Name="VoiceVolumeLabel"
                                       Grid.Column="1"
                                       Text="100%"
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <!-- Test Voice Button -->
                        <Button x:Name="TestVoiceButton"
                                Content="🔊 Test Voice"
                                Click="TestVoiceButton_Click"
                                HorizontalAlignment="Left"
                                Width="120"
                                Margin="0,0,0,18" />

                        <Separator Background="#3A3A46" Margin="0,0,0,16" />

                        <!-- Retro Sound Effects (SFX) -->
                        <TextBlock Text="Sound Effects (SFX)" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Playful audio cues for glass tapping, bubble pops, dizzy mouse shakes, and waking up."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                        <CheckBox x:Name="EnableSfxCheck"
                                  Foreground="#FFFFFF"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12"
                                  Click="EnableSfxCheck_Click">
                            <TextBlock Text="Enable Sound Effects" />
                        </CheckBox>

                        <TextBlock Text="SFX Volume" FontWeight="Medium" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SfxVolumeSlider"
                                    Grid.Column="0"
                                    Minimum="0" Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="80"
                                    ValueChanged="SfxVolumeSlider_ValueChanged" />
                            <TextBlock x:Name="SfxVolumeLabel"
                                       Grid.Column="1"
                                       Text="80%"
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button x:Name="TestSfxTapButton"
                                    Content="🎵 Test Tap"
                                    Click="TestSfxTapButton_Click"
                                    Width="100"
                                    Margin="0,0,10,0" />
                            <Button x:Name="TestSfxPopButton"
                                    Content="🫧 Test Pop"
                                    Click="TestSfxPopButton_Click"
                                    Width="100"
                                    Margin="0,0,10,0" />
                            <Button x:Name="TestSfxDizzyButton"
                                    Content="🌀 Test Dizzy"
                                    Click="TestSfxDizzyButton_Click"
                                    Width="100" />
                        </StackPanel>

                        <Separator Background="#3A3A46" Margin="0,0,0,16" />

                        <!-- Idle Chatter Settings -->
                        <TextBlock Text="Idle Chatter &amp; 'Tapping the Glass'" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Configure Grimlo's unprompted antics when you leave him sitting alone on your desktop."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                        <CheckBox x:Name="IdleChatterCheck"
                                  Foreground="#FFFFFF"
                                  FontWeight="Medium"
                                  Margin="0,0,0,14">
                            <TextBlock Text="Enable Idle Chatter (Grimlo taps the glass and complains)" />
                        </CheckBox>

                        <TextBlock Text="Idle Chatter Frequency" FontWeight="Medium" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="IdleIntervalSlider"
                                    Grid.Column="0"
                                    Minimum="2" Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="5"
                                    ValueChanged="IdleIntervalSlider_ValueChanged" />
                            <TextBlock x:Name="IdleIntervalLabel"
                                       Grid.Column="1"
                                       Text="Every 5 minutes"
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="Grimlo introduces subtle random timing variation so interruptions feel natural and unscripted."
                                   FontSize="11" Foreground="#7E7E8A" Margin="0,0,0,14" />

                        <Separator Background="#3A3A46" Margin="0,4,0,16" />

                        <!-- Deep Sleep Settings -->
                        <TextBlock Text="Sleep &amp; Drowse Cycles" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Grimlo gets drowsy and nods off into a deep, snoring sleep with floating Zzz's when left alone."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                        <CheckBox x:Name="EnableSleepCheck"
                                  Foreground="#FFFFFF"
                                  FontWeight="Medium"
                                  Margin="0,0,0,14">
                            <TextBlock Text="Enable Sleep Cycles (Grimlo naps when left idle)" />
                        </CheckBox>

                        <TextBlock Text="Deep Sleep Inactivity Timeout" FontWeight="Medium" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SleepIntervalSlider"
                                    Grid.Column="0"
                                    Minimum="3" Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="8"
                                    ValueChanged="SleepIntervalSlider_ValueChanged" />
                            <TextBlock x:Name="SleepIntervalLabel"
                                       Grid.Column="1"
                                       Text="After 8 minutes"
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drowsiness (half-mast eyelids) begins halfway to deep sleep. Click him anytime to startle him awake!"
                                   FontSize="11" Foreground="#7E7E8A" Margin="0,0,0,14" />

                        <Separator Background="#3A3A46" Margin="0,4,0,16" />

                        <!-- Windows Startup Settings -->
                        <TextBlock Text="Windows Startup" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Choose whether Grimlo awakens automatically when you log into Windows."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                        <CheckBox x:Name="StartWithWindowsCheck"
                                  Foreground="#FFFFFF"
                                  FontWeight="Medium"
                                  Margin="0,0,0,6">
                            <TextBlock Text="Launch Grimlo automatically on Windows startup" />
                        </CheckBox>
                        <TextBlock Text="Grimlo will wake up and deliver his custom opening greeting on your desktop as soon as you sign into Windows."
                                   FontSize="11" Foreground="#7E7E8A" Margin="22,0,0,16" />

                        <Separator Background="#3A3A46" Margin="0,4,0,16" />

                        <!-- Ambient Window Reactions -->
                        <TextBlock Text="Ambient Window Reactions" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Grimlo occasionally glances at what application you are using and makes unprompted remarks."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                        <CheckBox x:Name="WindowReactionsCheck"
                                  Foreground="#FFFFFF"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12">
                            <TextBlock Text="Enable Ambient Window Reactions" />
                        </CheckBox>

                        <TextBlock Text="Reaction Cooldown" FontWeight="Medium" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="WindowIntervalSlider"
                                    Grid.Column="0"
                                    Minimum="1" Maximum="15"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="3"
                                    ValueChanged="WindowIntervalSlider_ValueChanged" />
                            <TextBlock x:Name="WindowIntervalLabel"
                                       Grid.Column="1"
                                       Text="Every 3 minutes"
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="Minimum time Grimlo waits between commenting on active windows to avoid being spammy."
                                   FontSize="11" Foreground="#7E7E8A" Margin="0,0,0,16" />

                        <Separator Background="#3A3A46" Margin="0,4,0,16" />

                        <!-- Desktop Wander / Screen Edge Pacing -->
                        <TextBlock Text="Desktop Wander / Screen Edge Pacing" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Grimlo occasionally stretches his legs and paces back and forth along the bottom edge of your screen."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,14" />

                        <CheckBox x:Name="DesktopWanderCheck"
                                  Foreground="#FFFFFF"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12">
                            <TextBlock Text="Enable Desktop Wander / Screen Edge Pacing" />
                        </CheckBox>

                        <TextBlock Text="Wander Interval" FontWeight="Medium" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="WanderIntervalSlider"
                                    Grid.Column="0"
                                    Minimum="5" Maximum="30"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="12"
                                    ValueChanged="WanderIntervalSlider_ValueChanged" />
                            <TextBlock x:Name="WanderIntervalLabel"
                                       Grid.Column="1"
                                       Text="Every 12 minutes"
                                       Foreground="#81C784"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="Grimlo takes an animated patrol along your taskbar, inspects the area, and returns to his post."
                                   FontSize="11" Foreground="#7E7E8A" Margin="0,0,0,16" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: About & Credits -->
            <TabItem Header="📜 About &amp; Credits">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <StackPanel Margin="4,16,4,0">
                        <TextBlock Text="Grimlo the Desktop Gremlin" FontSize="18" FontWeight="Bold" Foreground="#81C784" />
                        <TextBlock Text="An eccentric, melodramatic desktop companion captive on your screen."
                                   FontSize="12" Foreground="#9E9EA8" Margin="0,4,0,18" />

                        <!-- Credits Card -->
                        <Border Background="#25252D" BorderBrush="#383844" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="✨ Application Credits" FontWeight="Bold" FontSize="14" Foreground="#ECECF1" Margin="0,0,0,12" />

                                <TextBlock Text="App Design &amp; Development" FontWeight="SemiBold" Foreground="#81C784" Margin="0,4,0,2" />
                                <TextBlock FontSize="12" Foreground="#E0E0E6" Margin="0,0,0,10">
                                    <Run Text="App designed by " />
                                    <Run Text="Noah Waddell" FontWeight="SemiBold" />
                                    <Run Text=" of " />
                                    <Hyperlink NavigateUri="https://ellijaylabs.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#66BB6A" TextDecorations="Underline">
                                        ellijaylabs.com
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Text="Open Source Software" FontWeight="SemiBold" Foreground="#81C784" Margin="0,4,0,2" />
                                <TextBlock Text="App code is free and open-source under the MIT License."
                                           FontSize="12" Foreground="#E0E0E6" Margin="0,0,0,10" />

                                <TextBlock Text="Character Art &amp; Visual Assets" FontWeight="SemiBold" Foreground="#81C784" Margin="0,4,0,2" />
                                <TextBlock Text="Original artwork created by Kris Sanford and may not be duplicated or sold."
                                           FontSize="12" Foreground="#E0E0E6" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Legal Notice Card -->
                        <Border Background="#25252D" BorderBrush="#383844" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="📜 License Summary" FontWeight="Bold" FontSize="13" Foreground="#ECECF1" Margin="0,0,0,8" />
                                <TextBlock Text="• Source Code: Licensed under the MIT License. Anyone can inspect, build, fork, and contribute."
                                           FontSize="11" Foreground="#9E9EA8" Margin="0,2" />
                                <TextBlock Text="• Artwork &amp; Rig: Copyright © 2026 Kris Sanford. All Rights Reserved. Permitted for personal use with Grimlo only."
                                           FontSize="11" Foreground="#9E9EA8" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer buttons & credits -->
        <Grid Grid.Row="1">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="11" Foreground="#888894" Margin="4,0,0,0">
                <Run Text="App by Noah Waddell (" /><Hyperlink NavigateUri="https://ellijaylabs.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#81C784" TextDecorations="None"><Run Text="ellijaylabs.com" /></Hyperlink><Run Text=") • Art by Kris Sanford" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,10,0" Width="85" />
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" Background="#2E7D32" BorderBrush="#388E3C" Width="85" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
